def atualizar_livro():
  print("\n---- ATUALIZAR LIVRO ----")
  id_busca = input("Digite o ID do livro que deseja atualizar: ").strip()

  try:
    id = (id_busca)
  except: 
    print("Livro não existe!")
    return
  
  livro_atual = livros_collection.find_one({"_id": id_busca})
  if not livro_atual:
        print("Livro não encontrado.")
        return

  print(f"\nLivro selecionado: {livro_atual['titulo']} por {livro_atual['autor']}")
  print("Insira os novos dados (Deixe em branco para MANTER o valor atual):")
    
  novo_titulo = input(f"Novo Título [{livro_atual.get('titulo')}]: ").strip()
  novo_autor = input(f"Novo Autor [{livro_atual.get('autor')}]: ").strip()
  novo_preco = input(f"Novo Preço [{livro_atual.get('preco')}]: ").strip()

  campos_atualizados = {}
  if novo_titulo: campos_atualizados["titulo"] = novo_titulo
  if novo_autor: campos_atualizados["autor"] = novo_autor
  if novo_preco:
    try:
      campos_atualizados["preco"] = float(novo_preco)
    except ValueError:
            print("Preço inválido. O preço original será mantido.")

    if not campos_atualizados:
        print("Nenhuma alteração informada.")
        return

    try:
        livros_collection.update_one({"_id": id_busca}, {"$set": campos_atualizados})
        print("Livro atualizado com sucesso!")
    except Exception as e:
        print(f"Erro ao atualizar: {e}")

def excluir_livro():
  print("\n---- EXCLUIR LIVRO ----")
  tit_busca = input("Digite o título do livro que deseja excluir: ").strip()

  try:
    titulo = (tit_busca)
  except:
    print("Título não existe!")
    return

  resultado = livros_collection.delete_one({"titulo": titulo})

  if resultado.deleted_count > 0:
    print("Livro excluído com sucesso!")
  else:
    print("Livro não encontrado.")

