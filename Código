def cadastrar_livro():
  print("\n---- CADASTRAR NOVO LIVRO ----")
  titulo = input("Título: ").strip()
  genero = input("Gênero: ").strip()
  autor = input("Autor: ").strip()
  ano_lanc = int(input("Ano de lançamento: "))
  estoque = int(input("Estoque: "))
  try:
    preco = float(input("Preço (R$): ").replace(',', '.'))
  except ValueError:
    preco = 0.0

  if not titulo or not autor:
    print("Título e Autor são obrigatórios!")
    return

  livro = {
      "titulo": titulo,
      "genero": genero,
      "autor": autor,
      "ano_lanc": ano_lanc,
      "estoque": estoque,
      "preco": preco
  }

  resultado = livros_collection.insert_one(livro)
  print(f"Livro cadastrado com sucesso! ID: {resultado.inserted_id}")

